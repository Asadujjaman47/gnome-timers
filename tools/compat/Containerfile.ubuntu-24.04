# GNOME Shell 46 (Ubuntu 24.04 LTS) for tools/compat/run.sh.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        gnome-shell gjs \
        dbus dbus-daemon dbus-user-session \
        libglib2.0-bin \
        gir1.2-gtk-4.0 gir1.2-adw-1 \
        gstreamer1.0-plugins-base gir1.2-gst-plugins-base-1.0 \
        libgl1-mesa-dri libegl-mesa0 \
        sound-theme-freedesktop \
        fonts-cantarell librsvg2-common \
        zip unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# systemd-logind cannot run in a container; without its D-Bus activation file
# GNOME Shell simply finds no login manager instead of failing to start it.
RUN rm -f /usr/share/dbus-1/system-services/org.freedesktop.login1.service
